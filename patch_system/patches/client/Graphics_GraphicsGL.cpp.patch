+            rgba_buffer[i + 2] = src[i];     // B = R
+            rgba_buffer[i + 3] = src[i + 3]; // A = A
+        }
+        glTexSubImage2D(GL_TEXTURE_2D, 0, x, y, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba_buffer.data());
